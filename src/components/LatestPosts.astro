---
// src/components/LatestPosts.astro
import type { Post } from '../lib/types';
import type { Category } from '../lib/types';
import Sidebar from './Sidebar.astro';
import { formatPostDate, getPostImage, stripHtml } from '../lib/media';
import { WORDPRESS_URL } from 'astro:env/server';

interface Props {
  posts: Post[];
  currentPage?: number;
  totalPages?: number;
  title?: string;
  searchTerm?: string;
  categories?: number;
  categoryList?: Category[];
  showSidebar?: boolean;
}

const {
  title,
  posts,
  currentPage = 1,
  totalPages = 1,
  searchTerm,
  categories,
  categoryList = [],
  showSidebar = true,
} = Astro.props;

const hasPosts = posts && posts.length > 0;
const currentSiteUrl = Astro.url.origin;
const categoryTitle = categoryList.find((category) => category.id === categories)?.name;
const archiveTitle = title || (searchTerm ? `Search results for: “${searchTerm}”` : categoryTitle || 'Latest Posts');

const getPageUrl = (page: number) => {
  let url = `/posts?page=${page}`;
  if (searchTerm) url += `&search=${searchTerm}`;
  if (categories) url += `&categories=${categories}`;
  return url;
};
---

{hasPosts ? (
  <div class="mx-auto max-w-[1140px] px-4">
    <div class={`grid gap-6 ${showSidebar ? "lg:grid-cols-[minmax(0,1fr)_320px]" : ""}`}>
      <main class="bg-white p-5 md:p-6">
        <header class="mb-6 border-b border-slate-100 pb-5">
          <h1 class="text-2xl font-bold">{archiveTitle}</h1>
          {categoryTitle && <p class="mt-1 text-sm text-slate-400">Category description here</p>}
        </header>

        <div class="divide-y divide-slate-100">
          {posts.map((post) => {
            const image = getPostImage(post, currentSiteUrl, WORDPRESS_URL);
            return (
              <article class="py-6 first:pt-0">
                <a href={`/${post.slug}`} class="group grid gap-5 md:grid-cols-[240px_minmax(0,1fr)]">
                  {image && (
                    <div class="relative h-48 overflow-hidden rounded-sm md:h-36">
                      <img src={image} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                      {categoryTitle && <span class="absolute left-2 top-2 bg-slate-700/80 px-2 py-1 text-xs font-bold text-white">{categoryTitle}</span>}
                    </div>
                  )}
                  <div>
                    <h2 class="text-2xl font-bold leading-tight group-hover:text-sky-600" set:html={post.title.rendered}></h2>
                    <p class="mt-3 text-sm">
                      <span class="font-bold">John Doe</span>
                      <span class="ml-4 text-slate-400">{formatPostDate(post.date)}</span>
                    </p>
                    <p class="mt-4 line-clamp-2 text-base leading-7 text-slate-700">{stripHtml(post.excerpt.rendered)}</p>
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        {totalPages > 1 ? (
          <div class="mt-8 flex justify-between text-sm">
            <div class="flex gap-2">
              {Array.from({ length: Math.min(totalPages, 3) }, (_, index) => index + 1).map((page) => (
                <a href={getPageUrl(page)} class={`grid h-8 w-8 place-items-center rounded-sm ${page === currentPage ? "bg-sky-500 text-white" : "bg-slate-100 hover:bg-sky-100"}`}>{page}</a>
              ))}
            </div>
            {currentPage < totalPages && (
              <a href={getPageUrl(currentPage + 1)} class="rounded-sm bg-slate-100 px-4 py-2 hover:bg-sky-500 hover:text-white">Next</a>
            )}
          </div>
        ) : (
          <div class="mt-8 text-right">
            <a href="/posts" class="rounded-sm bg-sky-500 px-4 py-2 text-sm font-bold text-white hover:bg-sky-600">View More Posts</a>
          </div>
        )}
      </main>

      {showSidebar && <Sidebar posts={posts} categories={categoryList} />}
    </div>
  </div>
) : (
  <div class="mx-auto max-w-[1140px] bg-white p-8">No posts available.</div>
)}
