---
// src/components/Header.astro
import { SITE_NAME } from "astro:env/server";

const siteName = SITE_NAME || "TSBlog";
---

<header class="bg-white shadow-sm">
  <div
    class="mx-auto flex max-w-[1140px] flex-col gap-4 px-4 py-5 md:flex-row md:items-center md:justify-between"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-3xl font-bold tracking-tight"
    >
      <span
        class="grid h-8 w-8 place-items-center rounded bg-sky-500 text-white"
        >✓</span
      >
      <span>
        {siteName.split(" ")[0] || "Visual"}<span class="text-sky-500"
          >{siteName.split(" ").slice(1).join("") || "Blogger"}</span
        >
      </span>
    </a>

    <div class="flex flex-col gap-4 md:flex-row md:items-center">
      <nav aria-label="Primary navigation">
        <ul
          class="flex flex-wrap gap-x-7 gap-y-3 text-sm font-medium text-slate-700"
        >
          <li><a href="/" class="hover:text-sky-600">Home</a></li>
          <li>
            <a href="/posts?categories=5" class="hover:text-sky-600">News</a>
          </li>
          <li>
            <a href="/posts?categories=3" class="hover:text-sky-600"
              >Archaeology</a>
          </li>
          <li>
            <a href="/posts?categories=2" class="hover:text-sky-600">Showbiz</a>
          </li>
          <li>
            <a href="/posts?categories=1" class="hover:text-sky-600"
              >Uncategorized</a>
          </li>
        </ul>
      </nav>

      <form method="GET" action="/posts" class="flex h-9 min-w-[220px]">
        <input
          type="search"
          name="search"
          placeholder="Search"
          class="min-w-0 flex-1 border border-slate-200 px-3 text-sm outline-none focus:border-sky-500"
        />
        <button
          class="grid w-11 place-items-center bg-sky-500 text-white hover:bg-sky-600"
          aria-label="Search"
        >
          <span aria-hidden="true">⌕</span>
        </button>
      </form>
    </div>
  </div>
</header>
