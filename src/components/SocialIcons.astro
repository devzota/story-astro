---
// src/components/SocialIcons.astro
const socialIcons = [
  {
    name: "X",
    url: "https://x.com/raddy_dev",
    image: "/x.svg",
    alt: "X Icon",
  },
  {
    name: "GitHub",
    url: "https://github.com/raddydev",
    image: "/github.svg",
    alt: "GitHub Icon",
  }
];
---
<div class="mb-4 flex justify-between">
  <h2 class="text-lg">Social Media</h2>
  <div class="flex gap-2">
    {socialIcons.map((socialIcon) => (
      <a
        href={socialIcon.url}
        target="_blank"
        rel="noopener noreferrer"
        class="border p-1 rounded-md hover:scale-110 transition duration-3"
      >
        <img
          src={`/social-icons${socialIcon.image}`}
          alt={socialIcon.alt}
          width="20"
          height="20"
          loading="eager"
        />
      </a>
    ))}
  </div>
</div>
