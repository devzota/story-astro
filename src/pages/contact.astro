---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us | TSBlog">
  <h2 class="text-xl mb-4">Contact Us</h2>
  <p class="mb-6">If you'd like to get in touch, please don't hesitate to reach out to us using the information below.</p>

  <div class="flex flex-col md:flex-row justify-center mb-6">
    <div class="w-full md:w-1/3 mb-4">
      <h2 class="text-lg mb-2">Address</h2>
      <p>55 Newyork St, US</p>
    </div>
    <div class="w-full md:w-1/3 mb-4">
      <h2 class="text-lg mb-2">Phone</h2>
      <p>+(1) 555-5555</p>
    </div>
    <div class="w-full md:w-1/3 mb-4">
      <h2 class="text-lg mb-2">Email</h2>
      <p><a href="mailto:example@example.com">example [@] example.com</a></p>
    </div>
  </div>
</BaseLayout>
