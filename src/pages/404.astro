---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | TSBlog">
  <div class="flex flex-col items-center justify-center mb-8">
    <h1 class="text-6xl font-bold text-amber-700">404</h1>
    <p class="mt-4 text-2xl text-gray-800">Oops! Page not found.</p>
    <p class="mt-2 text-gray-600">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="mt-6 px-4 py-2 bg-amber-700 text-white rounded hover:bg-amber-800 transition"
    >
      Go back home
    </a>
  </div>
</BaseLayout>
